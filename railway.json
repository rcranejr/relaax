{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @relaax/api build" },
  "deploy": {
    "startCommand": "pnpm --filter @relaax/db migrate && node apps/api/dist/server.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
